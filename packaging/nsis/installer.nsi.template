; HLX Generator — Windows NSIS Installer
; Generated by build_release.py — do not edit by hand.
;
; Requires NSIS 3.x: https://nsis.sourceforge.io/
; Pre-installed on GitHub Actions windows-latest runners.

Unicode True

!define APP_NAME     "HLX Generator"
!define APP_VERSION  "${VERSION}"
!define APP_PUBLISHER "edonahue"
!define APP_URL      "https://github.com/edonahue/hlx-generator"
!define INSTALL_DIR  "$PROGRAMFILES64\HLXGenerator"
!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\HLXGenerator"

; Output installer filename
OutFile "${DIST_DIR}\HLXGenerator-${VERSION}-Setup.exe"

Name "${APP_NAME} ${APP_VERSION}"
InstallDir "${INSTALL_DIR}"
InstallDirRegKey HKCU "Software\HLXGenerator" "Install_Dir"
RequestExecutionLevel admin
ShowInstDetails show
ShowUninstDetails show

; ── Pages ──────────────────────────────────────────────────────────────────
!include "MUI2.nsh"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${APP_DIR}\..\LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; ── Install Section ────────────────────────────────────────────────────────
Section "HLX Generator (required)" SecMain

    SectionIn RO
    SetOutPath "$INSTDIR"

    ; Copy entire PyInstaller onedir tree
    File /r "${APP_DIR}\*.*"

    ; Uninstaller
    WriteUninstaller "$INSTDIR\Uninstall.exe"

    ; Registry: uninstall entry
    WriteRegStr   HKLM "${UNINSTALL_KEY}" "DisplayName"          "${APP_NAME}"
    WriteRegStr   HKLM "${UNINSTALL_KEY}" "UninstallString"       "$INSTDIR\Uninstall.exe"
    WriteRegStr   HKLM "${UNINSTALL_KEY}" "DisplayVersion"        "${APP_VERSION}"
    WriteRegStr   HKLM "${UNINSTALL_KEY}" "Publisher"             "${APP_PUBLISHER}"
    WriteRegStr   HKLM "${UNINSTALL_KEY}" "URLInfoAbout"          "${APP_URL}"
    WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoModify"              1
    WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoRepair"              1

    ; Start Menu shortcut
    CreateDirectory "$SMPROGRAMS\${APP_NAME}"
    CreateShortcut  "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk" \
                    "$INSTDIR\HLXGenerator.exe" "" "$INSTDIR\HLXGenerator.exe" 0
    CreateShortcut  "$SMPROGRAMS\${APP_NAME}\Uninstall.lnk" \
                    "$INSTDIR\Uninstall.exe"

    ; Desktop shortcut (optional — user may delete)
    CreateShortcut "$DESKTOP\${APP_NAME}.lnk" \
                   "$INSTDIR\HLXGenerator.exe" "" "$INSTDIR\HLXGenerator.exe" 0

SectionEnd

; ── Uninstall Section ──────────────────────────────────────────────────────
Section "Uninstall"

    RMDir /r "$INSTDIR"

    Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk"
    Delete "$SMPROGRAMS\${APP_NAME}\Uninstall.lnk"
    RMDir  "$SMPROGRAMS\${APP_NAME}"

    Delete "$DESKTOP\${APP_NAME}.lnk"

    DeleteRegKey HKLM "${UNINSTALL_KEY}"
    DeleteRegKey HKCU "Software\HLXGenerator"

SectionEnd
